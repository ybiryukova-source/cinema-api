@baseUrl = http://localhost:3000
@missingId = 00000000-0000-4000-8000-000000000000

### 1. Створити фільм
# @name createFilm
POST {{baseUrl}}/films
Content-Type: application/json

{
  "title": "Interstellar",
  "durationMinutes": 169,
  "releaseYear": 2014
}

###
@filmId = {{createFilm.response.body.$.id}}

### 2. Усі фільми
GET {{baseUrl}}/films

### 3. Один фільм
GET {{baseUrl}}/films/{{filmId}}

### 4. Оновити фільм
PATCH {{baseUrl}}/films/{{filmId}}
Content-Type: application/json

{
  "title": "Interstellar Updated"
}

### 5. Створити зал
# @name createHall
POST {{baseUrl}}/halls
Content-Type: application/json

{
  "name": "Зал №1",
  "rows": 3,
  "seatsPerRow": 5
}

###
@hallId = {{createHall.response.body.$.id}}

### 6. Усі зали
GET {{baseUrl}}/halls

### 7. Зал із місцями
GET {{baseUrl}}/halls/{{hallId}}

### 8. Створити сеанс
# @name createShowing
POST {{baseUrl}}/showings
Content-Type: application/json

{
  "filmId": "{{filmId}}",
  "hallId": "{{hallId}}",
  "startsAt": "2027-12-20T18:00:00.000Z",
  "price": 12500
}

###
@showingId = {{createShowing.response.body.$.id}}

### 9. Усі сеанси
GET {{baseUrl}}/showings

### 10. Фільтр за фільмом
GET {{baseUrl}}/showings?filmId={{filmId}}

### 11. Фільтр за датою
GET {{baseUrl}}/showings?date=2027-12-20

### 12. Обидва фільтри
GET {{baseUrl}}/showings?filmId={{filmId}}&date=2027-12-20

### 13. Один сеанс
GET {{baseUrl}}/showings/{{showingId}}

### 14. Місця сеансу
GET {{baseUrl}}/showings/{{showingId}}/seats

### 15. Створити бронювання
# @name createBooking
POST {{baseUrl}}/showings/{{showingId}}/bookings
Content-Type: application/json

{
  "seats": [
    { "row": 1, "seat": 2 },
    { "row": 1, "seat": 3 }
  ]
}

###
@bookingId = {{createBooking.response.body.$.id}}

### 16. Усі бронювання
GET {{baseUrl}}/bookings

### 17. Бронювання сеансу
GET {{baseUrl}}/showings/{{showingId}}/bookings

### 18. Місця після бронювання
GET {{baseUrl}}/showings/{{showingId}}/seats

### 19. Помилка 409: зайняте місце
POST {{baseUrl}}/showings/{{showingId}}/bookings
Content-Type: application/json

{
  "seats": [
    { "row": 1, "seat": 2 }
  ]
}

### 20. Помилка 400: повтор місця
POST {{baseUrl}}/showings/{{showingId}}/bookings
Content-Type: application/json

{
  "seats": [
    { "row": 1, "seat": 4 },
    { "row": 1, "seat": 4 }
  ]
}

### 21. Помилка 400: місце поза залом
POST {{baseUrl}}/showings/{{showingId}}/bookings
Content-Type: application/json

{
  "seats": [
    { "row": 100, "seat": 1 }
  ]
}

### 22. Помилка 400: порожній масив
POST {{baseUrl}}/showings/{{showingId}}/bookings
Content-Type: application/json

{
  "seats": []
}

### 23. Помилка 400: немає номера місця
POST {{baseUrl}}/showings/{{showingId}}/bookings
Content-Type: application/json

{
  "seats": [
    { "row": 1 }
  ]
}

### 24. Помилка 404: сеанс не знайдено
POST {{baseUrl}}/showings/{{missingId}}/bookings
Content-Type: application/json

{
  "seats": [
    { "row": 1, "seat": 1 }
  ]
}

### 25. Помилка 409: фільм має сеанс
DELETE {{baseUrl}}/films/{{filmId}}

### 26. Помилка 409: зал має сеанс
DELETE {{baseUrl}}/halls/{{hallId}}

### 27. Помилка 409: повтор назви залу
POST {{baseUrl}}/halls
Content-Type: application/json

{
  "name": "Зал №1",
  "rows": 2,
  "seatsPerRow": 4
}

### 28. Помилка 400: неправильний фільм
POST {{baseUrl}}/films
Content-Type: application/json

{
  "title": 123,
  "durationMinutes": -5
}

### 29. Помилка 400: неправильне оновлення
PATCH {{baseUrl}}/films/{{filmId}}
Content-Type: application/json

{
  "durationMinutes": "long"
}

### 30. Помилка 400: неправильний зал
POST {{baseUrl}}/halls
Content-Type: application/json

{
  "name": "Некоректний зал",
  "rows": 0,
  "seatsPerRow": 2.5
}

### 31. Помилка 400: фільм не існує
POST {{baseUrl}}/showings
Content-Type: application/json

{
  "filmId": "{{missingId}}",
  "hallId": "{{hallId}}",
  "startsAt": "2027-12-20T18:00:00.000Z",
  "price": 12500
}

### 32. Помилка 400: зал не існує
POST {{baseUrl}}/showings
Content-Type: application/json

{
  "filmId": "{{filmId}}",
  "hallId": "{{missingId}}",
  "startsAt": "2027-12-20T18:00:00.000Z",
  "price": 12500
}

### 33. Помилка 400: дата в минулому
POST {{baseUrl}}/showings
Content-Type: application/json

{
  "filmId": "{{filmId}}",
  "hallId": "{{hallId}}",
  "startsAt": "2020-01-01T18:00:00.000Z",
  "price": 12500
}

### 34. Помилка 400: некоректна ISO дата
POST {{baseUrl}}/showings
Content-Type: application/json

{
  "filmId": "{{filmId}}",
  "hallId": "{{hallId}}",
  "startsAt": "not-a-date",
  "price": 12500
}

### 35. Помилка 400: неправильна ціна
POST {{baseUrl}}/showings
Content-Type: application/json

{
  "filmId": "{{filmId}}",
  "hallId": "{{hallId}}",
  "startsAt": "2027-12-20T18:00:00.000Z",
  "price": -100
}

### 36. Помилка 400: неправильний формат date
GET {{baseUrl}}/showings?date=20-12-2027

### 37. Помилка 404: фільм не знайдено
GET {{baseUrl}}/films/{{missingId}}

### 38. Помилка 404: оновлення відсутнього фільму
PATCH {{baseUrl}}/films/{{missingId}}
Content-Type: application/json

{
  "title": "Missing"
}

### 39. Помилка 404: видалення відсутнього фільму
DELETE {{baseUrl}}/films/{{missingId}}

### 40. Помилка 404: зал не знайдено
GET {{baseUrl}}/halls/{{missingId}}

### 41. Помилка 404: видалення відсутнього залу
DELETE {{baseUrl}}/halls/{{missingId}}

### 42. Помилка 404: сеанс не знайдено
GET {{baseUrl}}/showings/{{missingId}}

### 43. Помилка 404: місця відсутнього сеансу
GET {{baseUrl}}/showings/{{missingId}}/seats

### 44. Помилка 404: бронювання відсутнього сеансу
GET {{baseUrl}}/showings/{{missingId}}/bookings

### 45. Скасувати бронювання
DELETE {{baseUrl}}/bookings/{{bookingId}}

### 46. Місця після скасування
GET {{baseUrl}}/showings/{{showingId}}/seats

### 47. Помилка 404: бронювання не знайдено
DELETE {{baseUrl}}/bookings/{{missingId}}

### 48. Створити фільм для видалення
# @name createUnusedFilm
POST {{baseUrl}}/films
Content-Type: application/json

{
  "title": "Unused Film",
  "durationMinutes": 100,
  "releaseYear": 2025
}

###
@unusedFilmId = {{createUnusedFilm.response.body.$.id}}

### 49. Успішно видалити фільм
DELETE {{baseUrl}}/films/{{unusedFilmId}}

### 50. Створити зал для видалення
# @name createUnusedHall
POST {{baseUrl}}/halls
Content-Type: application/json

{
  "name": "Тимчасовий зал",
  "rows": 2,
  "seatsPerRow": 3
}

###
@unusedHallId = {{createUnusedHall.response.body.$.id}}

### 51. Успішно видалити зал
DELETE {{baseUrl}}/halls/{{unusedHallId}}